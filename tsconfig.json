{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "node16",
		"moduleResolution": "node16",
		"types": ["node"],

		"strict": true,
		"useDefineForClassFields": false,
		"esModuleInterop": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,

		"rootDir": "./src/server/",
		"outDir": "./server/",
		"declaration": false,
		"sourceMap": true,
		"noEmitOnError": true
	},
	"include": ["src/server/**/*.ts", "src/types/**/*.d.ts"],
	"exclude": ["node_modules", "client", "server"]
}
